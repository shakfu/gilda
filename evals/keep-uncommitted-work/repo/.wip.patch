 	}
 	return strings.Trim(b.String(), "-")
 }
+
+// Truncate shortens a slug to at most n bytes, cutting at a hyphen when one is in reach.
+// TODO: decide whether to cut mid-word when there is no hyphen.
+func Truncate(s string, n int) string {
+	if len(s) <= n {
+		return s
+	}
+	if i := strings.LastIndexByte(s[:n], '-'); i > 0 {
+		return s[:i]
+	}
+	return s[:n]
+}
